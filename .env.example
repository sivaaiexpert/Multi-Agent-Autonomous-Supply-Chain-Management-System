# Copy to .env and edit. NEVER commit the real .env (it is git-ignored). `make production-check` verifies this configuration.

# --- environment -------------------------------------------------------------
# development | production.  production REFUSES to start without a valid SCM_SECRET_KEY and rejects wildcard CORS.
SCM_ENV=development

# --- platform secret (encrypts stored integration secrets) ---------------------
# Generate:  python -c "from enterprise.secrets_store import generate_secret_key as g; print(g())"
# Losing this key makes stored integration secrets unreadable: back it up in your secret manager, not in the repository.
SCM_SECRET_KEY=

# --- storage -------------------------------------------------------------------
# Control plane (tenants, users, hashed API keys, platform audit) and one database per tenant live under SCM_DATA_DIR.
SCM_DATA_DIR=./data
# SCM_CONTROL_DB=./data/control.db
# SCM_BACKUP_DIR=./data/backups
# Legacy single-tenant paths (the "default" tenant):
SCM_DB_PATH=./data/supply_chain.db
SCM_OUTBOX=./data/outbox
SCM_CHECKPOINT_DB=./data/checkpoints.db

# --- API authentication --------------------------------------------------------
# Tenant users get keys from POST /api/v1/admin/users/{id}/keys (hashed in the control plane, shown once).
# Platform operators (SUPER_ADMIN, tenant management only) and the legacy default tenant use hashed env keys:
#   python -m scm.security gen-key --role SUPER_ADMIN --actor you
# Entries, comma-separated: <sha256 of the key>:<ROLE>:<actor>
#   ROLE = SUPER_ADMIN | TENANT_ADMIN | OPERATOR | APPROVER | ANALYST | VIEWER
# Leave empty and every protected endpoint refuses requests (secure by default).
SCM_API_KEYS=

# --- API hardening ---------------------------------------------------------------
SCM_RATE_LIMIT_PER_MIN=1200        # per API key (token bucket)
SCM_AUTH_FAILURES_PER_MIN=30       # per client IP, failed authentications
SCM_API_TIMEOUT=30                 # seconds per request
# SCM_CORS_ORIGINS=https://app.example.com   # comma-separated allow-list. Empty = CORS closed. "*" is refused in production.
SCM_ENFORCE_QUOTAS=0               # 1 = plan quotas return HTTP 429 (otherwise advisory)
SCM_ALLOW_PRIVATE_URLS=0           # 1 only for local mock servers: relaxes the SSRF guard on webhook / ERP targets
# SCM_HOST=127.0.0.1  SCM_PORT=8000  WEB_CONCURRENCY=1  SCM_FORWARDED_ALLOW_IPS=127.0.0.1   (make production)

# --- background maintenance (webhook retries, outbound delivery, approval timeouts) ---
SCM_BACKGROUND=0
SCM_MAINTENANCE_INTERVAL=30

# --- console (Streamlit) identity ------------------------------------------------
SCM_UI_ROLE=TENANT_ADMIN
SCM_UI_ACTOR=ui-operator

# --- LLM ---------------------------------------------------------------------------
SCM_LLM_ENABLED=0            # API workflows: 1 = use the local model, 0 = deterministic engines only
SCM_LLM_EMAILS=0
SCM_LLM__PRIMARY_MODEL=llama3.2
SCM_LLM__SECONDARY_MODEL=
SCM_LLM__FALLBACK_MODEL=llama3.2:1b
SCM_LLM__BASE_URL=http://localhost:11434
SCM_LLM__TIMEOUT_SECONDS=60
SCM_LLM__RETRIES=2
# Platform policy for per-tenant model choices (tenants may only pick from these):
# SCM_PLATFORM_ALLOWED_PROVIDERS=ollama
# SCM_PLATFORM_ALLOWED_MODELS=llama3.2,llama3.2:1b

# --- cost attribution (reporting only) -------------------------------------------
# SCM_COMPUTE_RATE_PER_CPU_HOUR=0.04
# SCM_INTEGRATION_COST_PER_CALL=0

# --- business policy defaults (per-tenant policies override these; every default lives in scm/settings.py) ---
SCM_OPTIMIZER__MAX_SUPPLIER_SHARE=0.7
SCM_APPROVAL__EXECUTIVE_REVIEW_TOTAL=1000000
SCM_RISK__PREDICTIVE_ALERTS=true

# --- observability ------------------------------------------------------------------
SCM_OBS__LOG_LEVEL=INFO

# Optional: a JSON file with the same structure as scm.settings.Settings (see config/engine.example.json)
# SCM_CONFIG_FILE=./config/engine.json
